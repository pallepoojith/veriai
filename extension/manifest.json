{
  "manifest_version": 3,
  "name": "ClaimCheck",
  "version": "0.1.0",
  "description": "Check links, posts and claims for misinformation and scam signals before you trust them.",
  "permissions": ["activeTab", "scripting", "contextMenus", "storage"],
  "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Check this page"
  },
  "background": { "service_worker": "background.js" }
}
